# 高德开放平台：Web 服务 API Key，用于 POI、路线、天气
AMAP_WEB_SERVICE_KEY=

# 高德开放平台：Web 端 JS API Key 和安全密钥，用于省份地图
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# DeepSeek：必须配置，用于有界 Agent 工具调用和交通方案祝语
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型：用于景区画廊和图片语义质量筛选；可与 DeepSeek 使用同一套 Key
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash

# SerpAPI Google Flights：用于长途航班票价和时间对比
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com

# 硅基流动：客服知识库 Embedding，使用 BAAI/bge-m3
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Langfuse：可选。未配置时观测层自动关闭，不影响业务运行
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

MAX_AGENT_TOOL_CALLS=24
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.db

# 生产基础设施：留空 REDIS_URL 时使用 SQLite + 进程内任务模式
DATABASE_URL=sqlite+aiosqlite:///data/travel_v2.db
DATABASE_AUTO_CREATE=true
REDIS_URL=
TRUST_PROXY_HEADERS=false
# 本地 HTTP 为 false；通过 HTTPS 部署时设为 true
COOKIE_SECURE=false

# API 稳定性
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
STREAM_RATE_LIMIT_PER_MINUTE=20
HTTP_MAX_ATTEMPTS=3
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_RECOVERY_SECONDS=30

# 持久化 Agent 任务
TASK_QUEUE_STREAM=travel:agent-tasks
TASK_QUEUE_GROUP=travel-agent-workers
TASK_CONSUMER_NAME=worker-1
TASK_MAX_ATTEMPTS=3
TASK_STALE_SECONDS=300

# 账户注册邀请码；留空会关闭新账户注册
REGISTRATION_INVITE_CODE=

# MCP：默认 stdio；远程模式可改为 sse 或 streamable-http
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8000/mcp
